# Encryption key is used to encrypt and decrypt the sensitive data stored
# in the database such as database credentials, secret keys, etc.
PBW_ENCRYPTION_KEY=""

# Database connection string for a PostgreSQL database where the pgbackweb
# will store its data.
PBW_POSTGRES_CONN_STRING=""

# The host on which the pgbackweb will listen for incoming HTTP requests.
PBW_LISTEN_HOST=""

# The port on which the pgbackweb will listen for incoming HTTP requests.
PBW_LISTEN_PORT=""

# Path prefix to use for all routes. If you set this to e.g. "/pgbackweb",
# the web interface will be available at http://<host>:<port>/pgbackweb
PBW_PATH_PREFIX=""

# Your timezone, this impacts logging, backup filenames and default timezone
# in the web interface.
TZ=""

# The timeouts below stop a stuck operation from holding resources forever.
# Each one bounds a LACK OF PROGRESS, never the total duration of a backup, so
# a slow but advancing backup is never interrupted no matter how long it takes.
# Raise them only if something in your setup legitimately pauses for longer.

# How long the connectivity check against each database may take before that
# database is marked unhealthy. Default 60s.
PBW_DATABASE_TEST_TIMEOUT=""

# How long a destination may go without consuming any of the backup before the
# backup is abandoned. Default 30m.
PBW_BACKUP_STALL_TIMEOUT=""

# How long a single write to a destination may block. Refreshed on every write.
# Default 2m.
PBW_DESTINATION_WRITE_TIMEOUT=""

# How long a destination may take to start answering a request. Default 5m.
PBW_DESTINATION_RESPONSE_TIMEOUT=""
